  "license": "MIT",
  "type": "module",
  "bin": {
    "excelcli": "bin/excelcli.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sbroenne/mcp-server-excel",
    "directory": "npm-packages/excelcli"
  },
  "homepage": "https://excelmcpserver.dev/",
  "bugs": {
    "url": "https://github.com/sbroenne/mcp-server-excel/issues"
  },
  "keywords": ["excel", "cli", "windows", "automation"],
  "dependencies": {
    "foreground-child": "^4.0.3"
  },
  "optionalDependencies": {
    "@sbroenne/excelcli-win32-x64": "file:../excelcli-win32-x64",
    "@sbroenne/excelcli-win32-arm64": "file:../excelcli-win32-arm64"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
