{
  "about": [
    "Hand-picked work weights for the public usage analytics report.",
    "Every MCP tool action and every excelcli command must appear here; the UsageAnalyticsWeightsTests checks fail when an action is missing or stale.",
    "Use heavy for actions that make Excel run a query, refresh, calculation engine, macro, or Data Model step; medium for other workbook changes and image exports; light for reads, lists, and window or housekeeping actions.",
    "Tool names use the MCP tool name without the _read suffix. cliCategories maps excelcli command categories to those tools."
  ],
  "levels": {
    "light": 1,
    "medium": 3,
    "heavy": 10
  },
  "features": [
    "power-query",
    "power-pivot-dax",
    "pivottables-charts",
    "tables-ranges",
    "vba",
    "worksheets-connections",
    "agent-mode",
    "python-in-excel",
    "other"
  ],
