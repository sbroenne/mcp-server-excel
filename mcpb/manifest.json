{
  "manifest_version": "0.3",
  "name": "excel-mcp",
  "display_name": "Excel",
  "version": "2.0.11",
  "description": "Automate the installed Excel desktop application on Windows x64 or Apple Silicon macOS",
  "long_description": "Excel MCP Server provides 31 specialized tools with 326 operations. Release builds stamp the exact platform, capabilities, and requirements into separate Windows x64 and Apple Silicon macOS bundles.",
  "author": {
    "name": "Stefan Broenner",
    "url": "https://github.com/sbroenne"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sbroenne/mcp-server-excel"
  },
  "homepage": "https://excelmcpserver.dev/",
  "documentation": "https://excelmcpserver.dev/",
  "support": "https://github.com/sbroenne/mcp-server-excel/issues",
  "icon": "icon-512.png",
  "license": "MIT",
  "privacy_policies": ["https://excelmcpserver.dev/privacy/"],
  "keywords": [
    "excel",
    "office",
    "spreadsheet",
    "automation",
    "power query",
    "m language",
    "dax",
    "data model",
    "power pivot",
    "vba",
    "macro",
    "table",
    "data analysis",
    "pivot table"
  ],
  "server": {
    "type": "binary",
    "entry_point": "server/excel-mcp-server",
    "mcp_config": {
      "command": "${__dirname}/server/excel-mcp-server",
      "args": [],
      "env": {}
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["win32", "darwin"]
  }
}
