{#-
  Overrides the stock sitemap (which lists URLs only) to add:

  1. <lastmod> - the git commit date of the content behind each page, including
     the canonical repo file a wrapper page mirrors. generate.py writes one
     partial per page; pages without git history simply have no <lastmod>.
  2. <video:video> - the home page embeds an intro video. Keep these fields in
     sync with the VideoObject JSON-LD in docs/index.md.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  {%- for page in pages -%}
    {%- if page.canonical_url %}
    <url>
         <loc>{{ page.canonical_url }}</loc>
         {% include "generated/lastmod/" ~ page.url ~ "index.html" ignore missing %}
         {%- if page.url == "" %}
         <video:video>
             <video:thumbnail_loc>https://i.ytimg.com/vi/wbw3-hPcE2o/maxresdefault.jpg</video:thumbnail_loc>
             <video:title>Excel MCP Server: Real Excel Automation for AI Agents</video:title>
             <video:description>Learn what Excel MCP Server is, when to use it, and how AI agents automate Power Query, DAX, PivotTables, VBA, Python, and calculations through real Microsoft Excel.</video:description>
             <video:player_loc>https://www.youtube.com/embed/wbw3-hPcE2o</video:player_loc>
             <video:duration>121</video:duration>
             <video:publication_date>2026-09-12T07:07:06-07:00</video:publication_date>
             <video:family_friendly>yes</video:family_friendly>
             <video:live>no</video:live>
         </video:video>
         {%- endif %}
    </url>
    {%- endif -%}
  {%- endfor %}
</urlset>
