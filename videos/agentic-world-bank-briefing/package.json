{
  "name": "agentic-world-bank-briefing",
  "private": true,
  "type": "module",
  "scripts": {
    "footage": "node prepare-footage.mjs",
    "slides": "node prepare-slides.mjs",
    "build": "node build.mjs",
    "dev": "npx --yes hyperframes@0.8.139 preview",
    "check": "npx --yes hyperframes@0.8.139 check",
    "render": "npm run render:quality",
    "render:quality": "npx --yes hyperframes@0.8.139 render --quality=high --crf=18 --resolution=landscape-4k --format=mp4 --output renders/agentic-world-bank-briefing-4k.mp4",
    "render:draft": "npx --yes hyperframes@0.8.139 render --quality=draft --resolution=landscape --format=mp4 --output renders/agentic-world-bank-briefing-draft.mp4",
    "publish": "npx --yes hyperframes@0.8.139 publish"
  }
}
